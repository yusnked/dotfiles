# Git のコミットハッシュを補完する.

emulate -L zsh

# Git リポジトリ外では補完しない.
# 本来はパス補完にフォールバックしたいが, _fzf_path_completion を呼び出すと
# zle reset-prompt が二重実行され, プロンプトの直前の行が消えるため断念.
git rev-parse --git-dir &>/dev/null || return

local preview='[[ {-1} =~ ^[0-9a-f]{40,}$ ]] && git --no-pager show --color=always --stat --patch {-1}'
(($+commands[delta])) && preview+=' | delta'

_fzf_complete \
    --ansi \
    --no-sort \
    --no-multi \
    --reverse \
    --delimiter=$'\t' \
    --with-nth='1,2..-2' \
    --accept-nth=-1 \
    --with-shell='zsh -fc' \
    --bind='enter:transform([[ {-1} =~ ^[0-9a-f]{40,}$ ]] && printf accept || printf ignore)' \
    --preview="$preview" \
    --preview-window='right,60%,<84(down,50%)' \
    -- "$@" < <(GIT_FZF_COMPLETION=1 git l --color=always)

