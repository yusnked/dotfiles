emulate -L zsh

(( $# >= 2 )) || {
    print -u2 "usage: ${0:t} TAG FILE..."
    return 2
}

local tag="$1" file tmp out
local -i ret=0
shift

for file in "$@"; do
    [[ "$file" == /* ]] || file="./$file"
    if [[ ! -f "$file" ]]; then
        print -u2 -r -- "${0:t}: not a regular file: $file"
        ret=1
        continue
    fi

    tmp=$(command mktemp -d "${file:h}/.ffretag.XXXXXXXX") || {
        ret=1
        continue
    }
    out="$tmp/${file:t}"

    {
        # カバー画像を除いた先頭の映像ストリームのタグだけを変更する.
        ffmpeg -nostdin -i "$file" -map 0 -c copy -tag:V:0 "$tag" "$out" &&
            command mv -- "$out" "$file" || ret=1
    } always {
        command rm -f -- "$out"
        command rmdir -- "$tmp"
    }
done

return $ret

