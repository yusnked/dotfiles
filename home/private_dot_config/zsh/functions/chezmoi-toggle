# Chezmoi toggle source-path <-> target-path

(( $+commands[chezmoi] )) || return 127

local dir
dir="$(chezmoi target-path "$PWD" 2>/dev/null || chezmoi source-path "$PWD" 2>/dev/null)"

if [[ -d "$dir" && -x "$dir" ]]; then
    builtin cd -- "$dir"
elif [[ "$PWD" == "$HOME" ]]; then
    builtin cd -- "$(chezmoi source-path)" || return
else
    print -u2 'chezmoi-toggle: not in a chezmoi-managed directory.'
    return 1
fi

