[[ -o interactive ]] || return

if [[ -v DOTS_ZPROFILE_LOADED ]]; then
    # 非ログインシェル時に必要な設定を再度書く.
    typeset -aU __dots_zcompile_paths
    source() { __dots_zcompile_paths+=("$1"); builtin source "$@"; }

    autoload -Uz __rc_print __cache_source

    typeset -U PATH path FPATH fpath
    typeset -TU INFOPATH infopath
else
    source "$ZDOTDIR/.zprofile"
fi
__dots_zcompile_paths+=("$ZDOTDIR/.zshrc")

source "$ZDOTDIR/rc/env.zsh"
source "$ZDOTDIR/rc/options.zsh"
source "$ZDOTDIR/rc/completion.zsh"

# Ghostty シェル統合 (プラグインの前に読み込む方が良い).
# 奇妙な書き方はキャッシュパスの短縮・一定化のため.
if [[ -n "$GHOSTTY_RESOURCES_DIR" ]]; then
    () {
        local integration="/shell-integration/zsh/ghostty-integration"
        __cache_source "$GHOSTTY_RESOURCES_DIR$integration" \
            'cat "$GHOSTTY_RESOURCES_DIR'$integration'"'
    }
fi

# plugins.zsh で zsh-defer が読み込まれるので遅延ロードはこれより下に書く.
zsh-defer() { autoload -Uz __zsh_defer_dummy; __zsh_defer_dummy "$@"; }
source "$ZDOTDIR/rc/plugins.zsh"

source "$ZDOTDIR/rc/prompt.zsh"

# 端末側の ^S/^Q によるフロー制御を無効化.
[[ -t 0 ]] && stty -ixon
source "$ZDOTDIR/rc/bindkey.zsh"

# mise
zsh-defer -a -c '(( $+commands[mise] )) && eval "$(mise activate zsh)"'

# zsh-patina activate は daemon 起動や socket path 生成を伴うためキャッシュ不可.
zsh-defer -c '(( $+commands[zsh-patina] )) && eval "$(zsh-patina activate)"'

# compinit
# FPATH 設定はこれより前, compdef を直接呼ぶ処理は zsh-defer を使ってこれより後に書く.
() {
    # 環境によって FPATH が異なり zcompdump の再生成が頻発することがあるので分ける.
    local dump="$XDG_CACHE_HOME/zsh/zcompdump/zsh-${ZSH_VERSION}-${TERM_PROGRAM:-unknown}"
    __dots_zcompile_paths+=("$dump")
    autoload -Uz compinit
    zsh-defer -a +p +r compinit -d "$dump"
}

# zoxide (after compinit)
zsh-defer -a __cache_source "$commands[zoxide]" 'zoxide init zsh'

zsh-defer -a source "$ZDOTDIR/rc/alias.zsh"

zsh-defer -a -c '
    if [[ -x /proc/$$/exe ]]; then
        export DOTS_ISHELL=$(readlink /proc/$$/exe)
    else
        export DOTS_ISHELL=$(lsof -ap$$ -dtxt -Fn | sed "3!d;s/.//;q")
    fi
'

zsh-defer -a -c '
    autoload -Uz __zcompile_paths && __zcompile_paths
    (( $+functions[__rc_print_flush] )) && __rc_print_flush
'

