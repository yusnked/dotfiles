[[ -o interactive ]] || return
[[ -v DOTS_ZPROFILE_LOADED ]] || source "$ZDOTDIR/.zprofile"

autoload -Uz __source_generated_cache

# 端末ドライバ側で ^S/^Q による出力停止・再開を無効にする.
[[ -t 0 ]] && stty -ixon 2> /dev/null

source "$ZDOTDIR/rc/options.zsh"
source "$ZDOTDIR/rc/completion.zsh"

__source_generated_cache "${commands[zsh-patina]}" zsh-patina.zsh 'zsh-patina activate'
__source_generated_cache "${commands[mise]}" mise.zsh 'mise activate zsh'

