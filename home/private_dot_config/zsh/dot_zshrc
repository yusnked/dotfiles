[[ -o interactive ]] || return
[[ -v DOTS_ZPROFILE_LOADED ]] || source "$ZDOTDIR/.zprofile"

fpath[1,0]="$ZDOTDIR/functions"
autoload -Uz __source_generated_cache __zcompile_sourced

typeset -gaU __dots_sourced_paths=("$ZDOTDIR/.zprofile" "$ZDOTDIR/.zshrc")
source() {
    __dots_sourced_paths+="$1"
    builtin source "$1"
}

zsh-defer() {
    autoload -Uz __zsh_defer_dummy
    __zsh_defer_dummy "$@"
}

source "$ZDOTDIR/rc/options.zsh"

source "$ZDOTDIR/rc/plugins.zsh"

zsh-defer -a +2 __source_generated_cache "${commands[zsh-patina]}" zsh-patina.zsh 'zsh-patina activate'
zsh-defer -a +2 __source_generated_cache "${commands[brew]}" homebrew.zsh 'brew shellenv'
zsh-defer -a +2 __source_generated_cache "${commands[mise]}" mise.zsh 'mise activate zsh'

# compinit が含まれるので fpath が全部追加された後に読み込む.
zsh-defer source "$ZDOTDIR/rc/completion.zsh"

zsh-defer -a +2 __zcompile_sourced

# PATH の一番上に更新.
zsh-defer -a -c '
    [[ -d "$HOME/.local/bin" ]] && path[1,0]="$HOME/.local/bin"
    [[ -d "$ZDOTDIR/functions" ]] && fpath[1,0]="$ZDOTDIR/functions"
'

# 端末ドライバ側で ^S/^Q による出力停止・再開を無効にする.
[[ -t 0 ]] && zsh-defer -a +12 stty -ixon

