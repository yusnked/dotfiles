export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

() {
    local dirs=(
        "$XDG_CACHE_HOME/zsh/source"
        "$XDG_CACHE_HOME/zsh/zcompdump"
        "$XDG_DATA_HOME/zsh"
        "$XDG_STATE_HOME/zsh"
        )
    for dir in "${dirs[@]}"; do
        [[ -d "$dir" ]] || command mkdir -m 0700 -p -- "$dir"
    done
}

# 後で zcompile するファイルのパスを記録する.
typeset -aU __dots_zcompile_paths
__dots_zcompile_paths+=("$ZDOTDIR/.zprofile")
source() { __dots_zcompile_paths+=("$1"); builtin source "$@"; }

autoload -Uz "$ZDOTDIR/functions/__cache_source"
[[ -o interactive ]] && autoload -Uz "$ZDOTDIR/functions/__rc_print"

# -U の重複削除は配列だけでなく, -T で配列と連動したスカラーにも適用される.
typeset -xU PATH path FPATH fpath
typeset -xTU INFOPATH infopath

# Homebrew
() {
    local brew
    if [[ -x /opt/homebrew/bin/brew ]]; then
        brew=/opt/homebrew/bin/brew
    elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
        brew=/home/linuxbrew/.linuxbrew/bin/brew
    fi
    [[ -n $brew ]] && __cache_source $brew "$brew shellenv zsh"
}
if [[ -n "$HOMEBREW_PREFIX" ]]; then
    path=(
        "$HOMEBREW_PREFIX/opt/ffmpeg-full/bin"(N-/)
        $path
    )
fi

path=(
    "$XDG_DATA_HOME/mise/shims"(N-/)
    "$HOME/.local/bin"
    $path
)

fpath=(
    "$ZDOTDIR/functions"
    "$ZDOTDIR/completions"
    $fpath
)

# GNU Info では INFOPATH の末尾に : (空エントリ) を置くとデフォルトの検索パスも使われる.
INFOPATH="${INFOPATH%:}:"

export LANG=en_US.UTF-8
export LC_TIME=C

# zsh のビルド対象で良ければ OSTYPE シェル変数も使える (例 darwin25.0).
export DOTS_OS="${DOTS_OS:-$(uname -s)}"

export DOTS_ZPROFILE_LOADED=1

