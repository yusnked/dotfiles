export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

() {
    local xdg dir
    for xdg in XDG_{DATA,STATE,CACHE}_HOME; do
        dir="${(P)xdg}/zsh"
        [[ -d "$dir" ]] || command mkdir -p -- "$dir"
    done
}

# -U の重複削除は配列だけでなく,-T で配列と連動したスカラーにも効く.
typeset -xU PATH path FPATH fpath
typeset -xTU INFOPATH infopath

# Homebrew
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
fi

path=(
    "$XDG_DATA_HOME/mise/shims"(N-/)
    "$HOME/.local/bin"
    $path
)

fpath=(
    "$ZDOTDIR/functions"
    "$ZDOTDIR/completions"
    $fpath
)

# GNU Info で INFOPATH の末尾に : (空エントリ) を置くとデフォルトの検索パスも使われる.
INFOPATH="${INFOPATH%:}:"

export LANG=en_US.UTF-8
export LC_TIME=C

# zsh のビルド対象で良ければ OSTYPE シェル変数も使える. (例 darwin25.0)
export DOTS_OS="${DOTS_OS:-$(uname -s)}"

export DOTS_ZPROFILE_LOADED=1

