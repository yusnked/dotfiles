# Ghostty が貼り付けた画面キャプチャのパスを取得し, エディタで開く.
# コマンドラインを確定せずに実行することで, 実行履歴や画面への表示を避ける.

autoload -Uz add-zle-hook-widget _terminal_title

__ghostty_screen_edit_execute() {
    emulate -L zsh

    (( __ghostty_screen_edit_cursor >= 0 )) || return 1

    {
        local file="$BUFFER"

        # コマンドラインを消去し, 空のプロンプトを再描画する.
        BUFFER=''
        zle -R

        [[ -f "$file" ]] || return 1

        # 空の引数を保持するために代入を 2 回に分ける.
        local -a editor_argv=(${(z)EDITOR})
        editor_argv=("${(@Q)editor_argv}")
        [[ -n "${editor_argv[1]}" ]] || return 1

        # Vim / Neovim の場合は, ファイルを開いた直後に最終行へ移動する.
        [[ ${editor_argv[1]:t} == (vim|nvim) ]] && editor_argv+=('+normal! G')

        "${editor_argv[@]}" "$file" </dev/tty
        local ret=$?

        # EDITOR によって変更されたタイトルを CWD 表示に戻す.
        (( _terminal_title_enabled )) && _terminal_title cwd

        return $ret
    } always {
        (( $? )) && zle -I

        # 元の入力内容を復元する.
        zle get-line && CURSOR=$__ghostty_screen_edit_cursor
        __ghostty_screen_edit_cursor=-1

        # Ghostty の一時ファイルとディレクトリを削除する.
        # .. やシンボリックリンク等がパスに含まれていた場合は削除しない.
        local dir="${file:h}"
        if [[ -f "$file" && -O "$file" && -O "$dir" &&
            "$file" == "${file:P}" &&
            "${file:t}" == screen.txt &&
            "${dir:t}" =~ '^[A-Za-z0-9_-]{22}$' &&
            "$file" == /(var|private/var|tmp)/* ]]
        then
            command rm -f -- "$file" && command rmdir -- "$dir" 2>/dev/null
        fi
    }
}

zle -N __ghostty_screen_edit_execute
bindkey '^[x' execute-named-cmd
typeset -gi __ghostty_screen_edit_cursor=-1

# コールバック前に入力が中断された場合も, 次の行で再実行できるようにする.
__ghostty_screen_edit_line_init() {
    __ghostty_screen_edit_cursor=-1
}
add-zle-hook-widget line-init __ghostty_screen_edit_line_init

# Ghostty の画面を一時ファイルに保存してエディタで開く.
ghostty-screen-edit() {
    emulate -L zsh

    if [[ $DOTS_OS != Darwin ]]; then
        return
    fi

    # 現在の入力内容をバッファスタックに退避しカーソル位置を保存する.
    (( __ghostty_screen_edit_cursor < 0 )) || return 1
    local -i cursor=$CURSOR
    zle push-line -n 1 || return 1
    __ghostty_screen_edit_cursor=$cursor

    # AppleScript で画面の内容を書き出した一時ファイルのパスを直接 ZLE に貼り付ける.
    # この方式を採用するのはクリップボードの内容を上書きせずに済むため.
    # Ghostty 側の入力処理は非同期に実行される.
    #
    # TTY を利用してパスを貼り付ける対象のサーフェス UUID を特定する.
    # tmux/screen 利用時は現在フォーカスされているサーフェスにフォールバックする.
    local target_tty=$TTY
    [[ -n $TMUX || -n $STY ]] && target_tty=''

    osascript - "$target_tty" >/dev/null <<'EOF'
        on run argv
            set targetTTY to item 1 of argv

            tell application "Ghostty"
                if targetTTY is "" then
                    set term to focused terminal of selected tab of front window
                else
                    set matches to {}

                    repeat with term in terminals
                        if (tty of term) is targetTTY then
                            set end of matches to (id of term)
                        end if
                    end repeat

                    if (count of matches) is not 1 then
                        error "Unable to uniquely identify Ghostty terminal"
                    end if

                    set term to terminal id (item 1 of matches)
                end if

                if not (perform action "write_screen_file:paste" on term) then
                    error "Failed to capture Ghostty screen"
                end if

                send key "x" modifiers "option" to term
                input text "__ghostty_screen_edit_execute" to term
                send key "enter" to term
            end tell
        end run
EOF

    # osascript が失敗したらバッファを元に戻す.
    local ret=$?
    if (( ret )); then
        zle -I
        zle get-line && CURSOR=$cursor
        __ghostty_screen_edit_cursor=-1
        return $ret
    fi
}

ghostty-screen-edit "$@"

