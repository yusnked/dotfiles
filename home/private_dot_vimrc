" --- Clipboard ------------------------------------------------------
" フォーカス時にクリップボードの内容が変わってたら " レジスタにセット.
if has('clipboard') && stridx(&clipboard, 'unnamed') == -1
    let s:clipboard_snapshot = ''

    function! s:ClipboardPullIfChanged() abort
        let clipboard = getreg('+')
        if clipboard ==# s:clipboard_snapshot | return | endif
        let type = stridx(clipboard, "\n") >= 0 ? 'V' : 'v'
        call setreg('"', clipboard, type)
        let s:clipboard_snapshot = clipboard
    endfunction

    augroup vimrc.clipboard_pull_on_focus
        autocmd!
        autocmd VimEnter,FocusLost * let s:clipboard_snapshot = getreg('+')
        autocmd FocusGained        * call s:ClipboardPullIfChanged()
    augroup END
endif

