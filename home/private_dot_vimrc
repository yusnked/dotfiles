    set diffopt+=linematch:60
endif
if has('patch-9.1.1243') " (2025-03-27)
    set diffopt+=inline:char
endif

set ignorecase
set smartcase
set hlsearch
set incsearch
if executable('rg')
    set grepprg=rg\ --vimgrep\ --smart-case\ --hidden\ --no-messages
                \\ --glob\ '!.git/*'
    set grepformat=%f:%l:%c:%m
endif

if exists('+jumpoptions') " patch-9.0.1921 (2023-09-21)
    set jumpoptions=stack
endif

set wildmenu
set wildmode=longest:full,full
set wildignorecase
set wildignore+=*/.git/*,*/node_modules/*,*/__pycache__/*
set wildignore+=*.swp,*.swo,*.tmp,*.bak,*.orig
if has('patch-8.2.4463') " (2022-02-24)
    set wildoptions=pum,tagfile,fuzzy
endif

set complete=.,w,b,u,t,i
set completeopt=menuone,noselect
if has('patch-8.1.1882') " (2019-08-18)
    set completeopt+=popup
else
    set completeopt+=preview
endif
if has('patch-9.1.0463') " (2024-06-03)
    set completeopt+=fuzzy
endif

set pumheight=15
if exists('+pumwidth') " patch-8.0.1491 (2018-02-10)
    set pumwidth=20
endif
if exists('+pummaxwidth') " patch-9.1.1250 (2025-03-28)
    set pummaxwidth=60
endif

set timeoutlen=800 " マッピングの待ち時間.
set ttimeoutlen=50 " 端末から来るキーコードの待ち時間.
set updatetime=1000

set history=500
set viminfo='100,<100,:500,/200,@100,s20,h

