    augroup vimrc.smart_relativenumber.scroll
        autocmd!
        autocmd WinScrolled * call s:RelNumOnScroll()
    augroup END
endif

" --- Prevent E173 ---------------------------------------------------
" 複数ファイルを引数に渡して起動した場合でも,
" 未編集の引数が残っていることによる E173 を発生させない.
augroup vimrc.prevent_E173
    autocmd!
    autocmd VimEnter * if argc() > 1 | silent! args % | endif
augroup END

