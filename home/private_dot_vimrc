    let s:is_root = exists('$USER') && $USER ==# 'root'
endif

" Neovim の stdpath とは違い root も考慮してディレクトリを返す.
function! s:Stdpath(type) abort
    let defaults = {
                \ 'config': '.config',
                \ 'data': '.local/share',
                \ 'state': '.local/state',
                \ 'cache': '.cache',
                \ }

    if !has_key(defaults, a:type)
        throw 'Invalid stdpath type: ' . a:type
    endif

    if s:is_root
        let home = expand('~root')
        if !isdirectory(home)
            let home = has('mac') ? '/private/var/root' : '/root'
        endif
        let base = home . '/' . defaults[a:type]
    else
        let env = eval('$XDG_' . toupper(a:type) . '_HOME')
        let base = env =~# '^/' ? env : expand('~/' . defaults[a:type])
    endif

    return base . '/vim'
endfunction

function! s:EnsureDir(dir) abort
    if empty(a:dir) | return 0 | endif
    if !isdirectory(a:dir)
        silent! call mkdir(a:dir, 'p', 0700)
    endif
    return isdirectory(a:dir)
endfunction

" --- Swap / Backup / Undo / Viminfo path ----------------------------
if !has('win32')
    let s:state_dir = s:Stdpath('state')

    let s:swap_dir = s:state_dir . '/swap'
    if s:EnsureDir(s:swap_dir)
        let s:swap_dir_escaped = escape(s:swap_dir, ',\')
        let &directory = s:swap_dir_escaped . '//,' . s:swap_dir_escaped
    endif

    let s:backup_dir = s:state_dir . '/backup'
    if s:EnsureDir(s:backup_dir)
        let s:backup_dir_escaped = escape(s:backup_dir, ',\')
        let &backupdir = s:backup_dir_escaped . '//,' . s:backup_dir_escaped
    endif

    if !s:is_root
        let s:undo_dir = s:state_dir . '/undo'
        if s:EnsureDir(s:undo_dir)
            set undofile
            " undodir は末尾に // がなくてもユニーク名になる.
            let &undodir = escape(s:undo_dir, ',\')
        endif
    endif

    let s:viminfo_dir = s:state_dir . '/viminfo'
    if s:EnsureDir(s:viminfo_dir)
        let &viminfofile = s:viminfo_dir . '/main.viminfo'
    endif
endif

" --- Smart relativenumber -------------------------------------------
augroup vimrc.smart_relativenumber
    autocmd!
    autocmd InsertLeave,CmdlineLeave,WinEnter,FocusGained,BufEnter
    \   * if &number && mode() != 'i' | set relativenumber | endif
    autocmd InsertEnter,CmdlineEnter,WinLeave,FocusLost
    \   * if &number | set norelativenumber | endif
augroup END

