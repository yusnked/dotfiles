" ====================================================================
" Single-file vimrc (Vim 8.0+)
" ====================================================================
scriptencoding utf-8

" Ubuntu では vi は vim.tiny へのリンクで /etc/vim/vimrc.tiny を読み込み,
" そこに set compatible の設定が含まれる.
" そもそも vi 互換というなら vimrc を読むべきではないが, 勝手に読み込んで
" 継続行でエラーを出してくるので改めて nocompatible をセットする.
set nocompatible

if v:version < 800
    echohl WarningMsg
    echomsg 'WARNING: This vimrc targets Vim 8.0+.' .
                \ ' Some settings may be ignored or may error.'
    echohl None
endif

" ====================================================================
" Core
" ====================================================================
" 機能フラグによって利用できない一部のオプションは隠しオプションとなり,
" 設定してもエラーにならず無視される (値の取得はエラー).

" -eval (vim.tiny など) では式を使えないが, 先頭の if と endif のみ認識し
" そのブロックをスキップする. ネストレベルも管理されるのでそれを逆手に取り
" 1 行の if 文を書くことでそれ以降の設定をスキップできる.

" modeline は root 起動時に自動的に無効化される.

" --- Options --------------------------------------------------------
set encoding=utf-8
set fileencoding=utf-8
set fileencodings=ucs-bom,utf-8,cp932,default,latin1

set noexrc
set confirm
set hidden " 未保存でバッファ切替できるようにする.
set autoread

set mouse=a
set belloff=all
set shortmess=aoOtTCFI

if has('title') && has('statusline')
    set title
    set titlestring=%t%(\ %M%)
endif

set number
set numberwidth=4 " -linebreak な vim.tiny では無視される.
set relativenumber
set cursorline
if exists('+cursorlineopt')
    set cursorlineopt=number
endif

set list " 不可視文字を表示.
set listchars=eol:↴,extends:…,nbsp:+,precedes:…,space:⋅,tab:>\ ,trail:-
set ambiwidth=single

set scrolloff=3
set sidescrolloff=3
set nowrap
set virtualedit=block

set expandtab
set tabstop=8 " Tab 文字の表示幅. 互換性の為 8 固定推奨 (らしい).
set shiftwidth=4
set softtabstop=-1 " 負の数指定で shiftwidth の値を使用.

" コメント継続を禁止. r: 挿入モード o: o/O コマンド.
set formatoptions-=r formatoptions-=o

set splitbelow
set splitright

" inline 未指定時は inline:simple として動作する.
set diffopt=filler,closeoff
if has('patch-8.1.0360') " (2018-09-11)
    " macOS 標準搭載の Vim では 内部 diff エンジンが利用できない.
    if !(has('mac') && $VIM ==# '/usr/share/vim')
        set diffopt+=internal,indent-heuristic,algorithm:histogram
    endif
endif
