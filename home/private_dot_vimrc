" --- GetVisualText --------------------------------------------------
function! s:GetVisualText() abort
    let v = getreg('z') | let t = getregtype('z')
    try
        silent! normal! gv"zy
        return getreg('z')
    finally
        call setreg('z', v, t)
    endtry
endfunction

" --- Debounce -------------------------------------------------------
let s:debounce_tbl = {}

function! s:Debounce__Fire(id, timer) abort
    if !has_key(s:debounce_tbl, a:id)
        return
    endif

    let entry = s:debounce_tbl[a:id]
    if entry[0] != a:timer
        return
    endif

    call remove(s:debounce_tbl, a:id)
    call call(entry[1], entry[2])
endfunction

function! s:Debounce(id, ms, cb, ...) abort
    if has_key(s:debounce_tbl, a:id)
        call timer_stop(remove(s:debounce_tbl, a:id)[0])
    endif

    let timer = timer_start(a:ms, function('s:Debounce__Fire', [a:id]))
    if timer != -1
        let s:debounce_tbl[a:id] = [timer, a:cb, a:000]
    endif

    return timer
endfunction

" --- FmtBytes -------------------------------------------------------
function! s:FmtBytes(bytes) abort
    if a:bytes <= 0 | return '' | endif
    let u = ['B','K','M','G','T','P','E']
    let i = 0 | let v = str2float(a:bytes)
    while v >= 1024.0 | let v /= 1024.0 | let i += 1 | endwhile
    return i ? printf('%.1f%s', v, u[i]) : printf('%d%s', a:bytes, u[0])
endfunction

" --- SubwordRange ---------------------------------------------------
" カーソル位置の subword の範囲を返す.
function! s:SubwordRange() abort
    let text = getline('.')
    let length = strlen(text)
    if length == 0 | return [0, 1] | endif

    let cursor = col('.') - 1
    if cursor >= length
        let cursor = matchstrpos(text, '.$')[1]
    endif

    " 区切り文字上なら右, なければ左の単語へ寄せる.
    if text[cursor] =~# '[_-]'
        if cursor + 1 < length && text[cursor + 1] =~# '[A-Za-z0-9]'
            let cursor += 1
        elseif cursor > 0 && text[cursor - 1] =~# '[A-Za-z0-9]'
            let cursor -= 1
        else
            return [cursor, cursor + 1]
        endif
    endif

    let subword_pat = '\v(\u+(\ze\u\l)|\u?\l+|\u+|\d+)'
    let offset = 0
    while 1
        let [_, start, end] = matchstrpos(text, subword_pat, offset)
        if start < 0 || start > cursor | break | endif
        if cursor < end | return [start, end] | endif
        let offset = end
    endwhile

    " マッチしなければカーソル位置の 1 文字を対象にする.
    return [cursor, cursor + strlen(matchstr(strpart(text, cursor), '^.'))]
endfunction

" ====================================================================
" Functions: Map
" ====================================================================
" Visual 選択を検索レジスタ (@/) へセット.
function! s:VisualSetSearch() abort
    let pat = escape(s:GetVisualText(), '\')
    if empty(pat) | return | endif

    let @/ = '\V' . substitute(pat, "\n", '\\n', 'g')
    if histget('search', -1) !=# @/
        call histadd('search', @/)
    endif

    keepjumps normal! `<
endfunction

" <C-v> での一括挿入を V にも追加 (ただし gv の範囲はおかしくなる).
function! s:NeoVisualLine(rhs) abort
    let tbl = {'A': "\<C-v>0o$A", 'I': "\<C-v>^o^I", 'gI': "\<C-v>0o$I"}
    return mode() ==# 'V' ? tbl[a:rhs] : a:rhs
endfunction

" バッファ名またはフルパスをクリップボードにコピー.
function! s:YankBufnameOrFullPath() abort
    let path = expand('%:p')
    let name = empty(path) ? bufname('%') : path
    if empty(name) | echo 'No buffer name.' | return | endif

    let @+ = name
    echo 'Copied ' . (empty(path) ? 'buffer name' : 'full path') . ' to @+.'
endfunction

" 空行を現在行の上または下に count 行挿入.
function! s:PutBlankLines(below, count) abort
    let view = winsaveview()
    let c = max([1, a:count])

    execute 'silent keepjumps keepmarks put' . (a:below ? '' : '!')
                \ . '=repeat(nr2char(10), c)'

    if !a:below
        if view.lnum <= view.topline
            let view.topline += c
        endif
        let view.lnum += c
    endif

    call winrestview(view)
endfunction

" Subword text object.
function! s:SelectSubword(around) abort
    let [start, end] = s:SubwordRange()
    let text = getline('.')

    if a:around
        if start > 0 && text[start - 1] =~# '[_-]'
            let start -= 1
        elseif end < strlen(text) && text[end] =~# '[_-]'
            let end += 1
        endif
    endif

    " バイト位置を Visual 選択用の文字境界に変換する.
    let end_col = matchstrpos(strpart(text, 0, end), '.$')[1] + 1
    call setpos("'<", [0, line('.'), start + 1, 0])
    call setpos("'>", [0, line('.'), end_col, 0])
    normal! `<v`>
endfunction

" ====================================================================
" Functions: Autocmd
" ====================================================================
" --- Smart relativenumber -------------------------------------------
function! s:RelNumRestore() abort
    if &number && mode() !=# 'i' && !&relativenumber
        set relativenumber
    endif
endfunction

function! s:RelNumOnScroll() abort
    if !&number | return | endif
    if &relativenumber | set norelativenumber | endif

    " スクロール停止から 700 ms 後に相対行番号を復元する (Insert mode 以外).
    call s:Debounce('s:RelNumOnScroll', 700, function('s:RelNumRestore'))
endfunction

" --- Statusline -----------------------------------------------------
function! s:StlBufCount__Update() abort
    let g:vimrc_stl_buf_total = ':' . len(filter(
        \ range(1, bufnr('$')), 'buflisted(v:val)'
        \ ))
    redrawstatus
endfunction

function! s:StlBufCount() abort
    call s:Debounce('s:StlBufCount', 50, function('s:StlBufCount__Update'))
endfunction

function! s:StlFileSize(file) abort
    let size = getfsize(expand(a:file))
    if size > 0
        let w:vimrc_stl_file_size = s:FmtBytes(size) . ' '
    else
        let w:vimrc_stl_file_size = ''
    endif
endfunction

" --- Autoread checktime ---------------------------------------------
function! s:AutoReadChecktime() abort
    " cmdline-window で checktime すると事故ることがあるので回避.
    if !empty(getcmdwintype()) | return | endif

    if mode() ==# 'c' | return | endif
    if !empty(&buftype) || &modified | return | endif

    let fname = expand('%:p')
    if empty(fname) | return | endif
    silent! execute 'checktime ' . fnameescape(fname)
endfunction

